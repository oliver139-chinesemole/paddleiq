# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
# .env.example is intentionally NOT ignored

# Supabase local dev artifacts
supabase/.branches
supabase/.temp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# mediapipe pose assets (staged at build time by scripts/fetch-pose-assets.mjs)
/public/mediapipe

# playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache

# Generated service workers — rebuilt by `npm run build`, which Render runs.
# The swe-worker filename is content-hashed, so committing it leaves an orphan
# on every change.
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
